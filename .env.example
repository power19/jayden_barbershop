# ─────────────────────────────────────────────────────────────────
#  Jayden's Barbershop — WhatsApp Bot + Admin Dashboard Config
#  Copy this file to .env and fill in your values
# ─────────────────────────────────────────────────────────────────

# ── Shop Info ──────────────────────────────────────────────────────
SHOP_NAME=Jayden's Barbershop
SHOP_ADDRESS=Your Street Address, Paramaribo, Suriname
SHOP_PHONE=+597 XXX-XXXX
SHOP_EMAIL=info@jaydensbarbershop.com
SHOP_INSTAGRAM=@jaydensbarbershop
GOOGLE_MAPS_LINK=https://maps.google.com/?q=your+location

# ── Regional Settings ──────────────────────────────────────────────
CURRENCY=SRD
TIMEZONE=America/Paramaribo

# ── Google Calendar ────────────────────────────────────────────────
# Fallback calendar (used if an employee has no personal calendar set)
GOOGLE_CALENDAR_ID=primary
GOOGLE_CREDENTIALS_PATH=./credentials/service-account.json

# ── Admin Dashboard ────────────────────────────────────────────────
ADMIN_PASSWORD=changeme123
ADMIN_PORT=3000

# ── Bot Settings ───────────────────────────────────────────────────
BOOKING_DAYS_AHEAD=14
SESSION_TIMEOUT_MINUTES=30

# ── Database ───────────────────────────────────────────────────────
DB_PATH=./data/barbershop.db
